# Model used for prose (bullets, summary, fixes). provider/model-id.
# The app runs without any key: analysis is deterministic and the rewrite falls back to rule-based edits.
AI_MODEL=anthropic/claude-opus-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # if AI_MODEL=openai/...
# AI_GATEWAY_API_KEY=        # route any provider/model string through the Vercel AI Gateway

# Upstash Redis for rate limits and anonymous session state. Without these an in-memory store is used (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional sign-in, only needed to save versions past 7 days. Any provider with both values set appears in the UI.
AUTH_SECRET=                 # >= 16 random chars, signs the user cookie
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
